<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RocketRPG</AssemblyName>
    <RootNamespace>RocketRPG</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\RocketRPG.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
    <Version>1.1.2</Version>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\RocketRPG.ico" />
    <EmbeddedResource Include="Shaders\*.ps" />
    <EmbeddedResource Include="Resources\rocket_mkxp_agent.rb" LogicalName="RocketRPG.Resources.rocket_mkxp_agent.rb" />
    <EmbeddedResource Include="Resources\rocket_mkxp_autotest.rb" LogicalName="RocketRPG.Resources.rocket_mkxp_autotest.rb" />
    <EmbeddedResource Include="Resources\rocket_rgss18_compat.rb" LogicalName="RocketRPG.Resources.rocket_rgss18_compat.rb" />
    <EmbeddedResource Include="Resources\rocket_win32_fallbacks.rb" LogicalName="RocketRPG.Resources.rocket_win32_fallbacks.rb" />
    <EmbeddedResource Include="Resources\nw_shim.js" LogicalName="RocketRPG.Resources.nw_shim.js" />
    <EmbeddedResource Include="Resources\mv_autotest.js" LogicalName="RocketRPG.Resources.mv_autotest.js" />
    <EmbeddedResource Include="Resources\multi.html" LogicalName="RocketRPG.Resources.multi.html" />
    <EmbeddedResource Include="Resources\rocket_multi_frames.js" LogicalName="RocketRPG.Resources.rocket_multi_frames.js" />
    <EmbeddedResource Include="Resources\rocket_extra.js" LogicalName="RocketRPG.Resources.rocket_extra.js" />
    <EmbeddedResource Include="Resources\default_assets.json" LogicalName="RocketRPG.Resources.default_assets.json" />
    <EmbeddedResource Include="Resources\rocket_rgss_loader.rb" LogicalName="RocketRPG.Resources.rocket_rgss_loader.rb" />
    <EmbeddedResource Include="Resources\mkxp-preload\*.rb" LogicalName="RocketRPG.Resources.mkxp_preload.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\build\core\RocketRPGCore.dll" Condition="Exists('..\..\build\core\RocketRPGCore.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>RocketRPGCore.dll</Link>
    </Content>
    <!-- 라이선스 원문과 고지: 배포 폴더의 licenses\ (정보 > RocketRPG 정보에서 인터넷 없이 열람) -->
    <Content Include="..\Licenses\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>licenses\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\runtimes\**\*" Condition="Exists('..\..\runtimes')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
</Project>
