<Window x:Class="RocketRPG.Views.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="단축키 설정" Height="500" Width="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" FontFamily="Segoe UI, 맑은 고딕" FontSize="12"
        Background="#FFF0F0F0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 안내 문구 -->
        <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="#FF333333" TextWrapping="Wrap"
                   Text="원하는 기능을 선택한 후 아래 입력 상자에서 단축키를 입력하여 자유롭게 변경할 수 있습니다."/>

        <!-- 카테고리 탭 및 단축키 리스트 -->
        <TabControl x:Name="CategoryTabs" Grid.Row="1" SelectionChanged="CategoryTabs_SelectionChanged" Background="White">
            <TabItem Header="일반" Tag="일반">
                <ListView x:Name="ListGeneral" SelectionChanged="HotkeyListView_SelectionChanged"
                          BorderThickness="0" Margin="4">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="기능" Width="140" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="단축키" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CurrentGesture}" FontWeight="SemiBold" Foreground="#FF0066CC"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="설명" Width="290" DisplayMemberBinding="{Binding Description}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="치트 &amp; 디버그" Tag="치트 &amp; 디버그">
                <ListView x:Name="ListCheat" SelectionChanged="HotkeyListView_SelectionChanged"
                          BorderThickness="0" Margin="4">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="기능" Width="140" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="단축키" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CurrentGesture}" FontWeight="SemiBold" Foreground="#FF0066CC"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="설명" Width="290" DisplayMemberBinding="{Binding Description}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="뷰어 &amp; ESP" Tag="뷰어 &amp; ESP">
                <ListView x:Name="ListViewer" SelectionChanged="HotkeyListView_SelectionChanged"
                          BorderThickness="0" Margin="4">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="기능" Width="140" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="단축키" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CurrentGesture}" FontWeight="SemiBold" Foreground="#FF0066CC"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="설명" Width="290" DisplayMemberBinding="{Binding Description}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>

        <!-- 단축키 할당/수정 패널 -->
        <GroupBox Grid.Row="2" Header="단축키 변경" Margin="0,10,0,10" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="새 단축키 입력:"/>
                <TextBox x:Name="KeyInputBox" Grid.Column="1" VerticalAlignment="Center" Padding="4,3"
                         PreviewKeyDown="KeyInputBox_PreviewKeyDown" IsReadOnly="True"
                         ToolTip="여기를 클릭하고 원하는 키 조합(예: Ctrl+Shift+S)을 직접 누르세요."/>
                <Button x:Name="BtnAssign" Grid.Column="2" Content="할당" Width="60" Margin="8,0,0,0"
                        Padding="4,2" Click="BtnAssign_Click"/>
                <Button x:Name="BtnClear" Grid.Column="3" Content="해제" Width="60" Margin="6,0,0,0"
                        Padding="4,2" Click="BtnClear_Click"/>
            </Grid>
        </GroupBox>

        <!-- 하단 네이티브 다이얼로그 버튼 영역 -->
        <DockPanel Grid.Row="3">
            <Button x:Name="BtnResetDefaults" Content="기본값으로 복원(_R)" Width="130" Height="26"
                    DockPanel.Dock="Left" Click="BtnResetDefaults_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="BtnOk" Content="확인" Width="75" Height="26" Margin="6,0,0,0" IsDefault="True" Click="BtnOk_Click"/>
                <Button x:Name="BtnCancel" Content="취소" Width="75" Height="26" Margin="6,0,0,0" IsCancel="True" Click="BtnCancel_Click"/>
                <Button x:Name="BtnApply" Content="적용(_A)" Width="75" Height="26" Margin="6,0,0,0" Click="BtnApply_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
