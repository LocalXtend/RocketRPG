<UserControl x:Class="RocketRPG.Views.NotesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RocketRPG.Views"
             Background="#FFF0F0F0" FontSize="12">
    <!-- 게임 노트 / 일반 메모 (오른쪽 도킹 패널 또는 따로 창): 페이지 탭 + 무한 캔버스. 윈도우 기본 스타일 -->
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="#FFA0A0A0" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="✕" Width="22" Height="20" Padding="0"
                            ToolTip="노트 닫기 (Ctrl+N)" Click="BtnClose_Click"/>
                    <Button x:Name="BtnDetach" DockPanel.Dock="Right" Content="분리" Height="20" Padding="6,0" Margin="0,0,4,0"
                            ToolTip="노트를 따로 창으로 띄우기" Click="BtnDetach_Click"/>
                    <TextBlock x:Name="TitleText" Text="일반 메모" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <!-- 게임 노트 / 일반 메모 전환 (게임이 없으면 일반 메모만) -->
                <StackPanel x:Name="ModeBar" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                    <RadioButton x:Name="ModeGame" Content="게임 노트" GroupName="NotesMode" Margin="0,0,12,0" Checked="ModeGame_Checked"/>
                    <RadioButton x:Name="ModeGeneral" Content="일반 메모" GroupName="NotesMode" Checked="ModeGeneral_Checked"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 페이지 탭: 누르면 전환, 두 번 누르면 이름 바꾸기, 오른쪽 클릭 메뉴 -->
        <Border DockPanel.Dock="Top" Padding="4,4,4,0">
            <WrapPanel x:Name="PageTabs"/>
        </Border>

        <Border DockPanel.Dock="Top" BorderBrush="#FFA0A0A0" BorderThickness="0,1,0,1" Padding="4">
            <WrapPanel>
                <Button x:Name="BtnText" Content="메모" Padding="8,2" Margin="0,0,4,0" ToolTip="화면 가운데에 새 메모 (빈 곳 더블 클릭도 가능)" Click="BtnText_Click"/>
                <Button x:Name="BtnLabel" Content="글상자" Padding="8,2" Margin="0,0,4,0" ToolTip="배경 없는 글을 자유롭게 놓기 (두 번 눌러 쓰기, 끌어서 이동)" Click="BtnLabel_Click"/>
                <Button x:Name="BtnImage" Content="이미지..." Padding="8,2" Margin="0,0,4,0" ToolTip="이미지/GIF 파일 넣기 (파일을 끌어 놓거나 Ctrl+V로 붙여 넣어도 됩니다)" Click="BtnImage_Click"/>
                <Button x:Name="BtnShot" Content="스크린샷" Padding="8,2" Margin="0,0,4,0" ToolTip="지금 게임 화면을 찍어 노트에 넣기 (Ctrl+Shift+S)" Click="BtnShot_Click"/>
                <Button Content="전체 보기" Padding="8,2" Margin="0,0,4,0" Click="BtnFit_Click"/>
                <Button Content="100%" Padding="8,2" Click="BtnZoom100_Click"/>
            </WrapPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Margin="6,3" Foreground="#FF666666" TextWrapping="Wrap" FontSize="11"
                   Text="더블 클릭: 메모 · 휠: 확대/축소 · 오른쪽 버튼 끌기: 이동 · Ctrl+V: 붙여넣기 · Delete: 삭제 · 서식: *기울임* **굵게** _밑줄_ ~~취소선~~"/>

        <Border BorderBrush="#FFA0A0A0" BorderThickness="0,0,0,1">
            <views:NotesCanvas x:Name="Canvas"/>
        </Border>
    </DockPanel>
</UserControl>
