<Window x:Class="RocketRPG.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:RocketRPG.Views"
        Title="RocketRPG" Height="720" Width="1080"
        Background="#FF1E1E1E"
        KeyDown="OnKeyDown"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        KeyboardNavigation.DirectionalNavigation="None"
        KeyboardNavigation.TabNavigation="None"
        KeyboardNavigation.ControlTabNavigation="None"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" FontSize="13" Padding="4,2">
            <MenuItem Header="파일(_F)">
                <MenuItem x:Name="GameLibraryMenuItem" Header="쯔꾸르 모음(_G)..." Click="OnGameLibrary"/>
                <MenuItem Header="쯔꾸르 불러오기(_O)..." Click="OnLoadGame"/>
                <Separator/>
                <MenuItem x:Name="HistoryMenu" Header="히스토리(_H)">
                    <MenuItem Header="(현재 불러온 기록이 없습니다.)" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="RestartMenuItem" Header="재시작(_R)" Click="OnRestart" IsEnabled="False"/>
                <MenuItem x:Name="GameExitMenuItem" Header="게임 종료(_X)" Click="OnGameExit" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="종료(_Q)" Click="OnExit"/>
            </MenuItem>
            <MenuItem x:Name="ScreenMenu" Header="화면(_V)" IsEnabled="False">
                <MenuItem x:Name="RatioMenu" Header="비율(_R)" ToolTip="출력될 게임 화면의 비율을 고정합니다. '없음'은 게임 화면을 창에 꽉 채웁니다.">
                    <MenuItem Header="없음" Tag="none" IsChecked="True" Click="OnRatio"/>
                    <MenuItem Header="21:9" Tag="21:9" Click="OnRatio"/>
                    <MenuItem Header="16:9" Tag="16:9" Click="OnRatio"/>
                    <MenuItem Header="4:3" Tag="4:3" Click="OnRatio"/>
                </MenuItem>
                <MenuItem x:Name="GammaMenu" Header="밝기(_B)" ToolTip="쯔구르의 감마 값을 변경하여 밝기를 조절합니다.">
                    <MenuItem Header="0%"   Tag="0.05"  Click="OnGamma"/>
                    <MenuItem Header="20%"  Tag="0.2"   Click="OnGamma"/>
                    <MenuItem Header="40%"  Tag="0.4"   Click="OnGamma"/>
                    <MenuItem Header="60%"  Tag="0.6"   Click="OnGamma"/>
                    <MenuItem Header="80%"  Tag="0.8"   Click="OnGamma"/>
                    <MenuItem Header="100%" Tag="1.0" IsChecked="True" Click="OnGamma"/>
                    <MenuItem Header="150%" Tag="1.5"   Click="OnGamma"/>
                    <MenuItem Header="200%" Tag="2.0"   Click="OnGamma"/>
                    <MenuItem Header="400%" Tag="4.0" Click="OnGamma"/>
                </MenuItem>
                <MenuItem x:Name="FilterMenu" Header="필터(_L)" ToolTip="화면 화질 개선 필터를 선택합니다. 실행 중인 엔진에서 쓸 수 없는 필터는 흐리게 표시됩니다.">
                    <MenuItem Header="원본(없음)" Tag="none" IsChecked="True" Click="OnFilter"/>
                    <MenuItem Header="도트 확대(xBRZ) + 선명하게" Tag="xbrz_cas" Click="OnFilter"/>
                    <MenuItem Header="부드러운 확대(Lanczos) + 선명하게" Tag="fsr_cas" Click="OnFilter"/>
                    <MenuItem Header="부드러운 확대(Bicubic) + 선명하게" Tag="scalefx_cas" Click="OnFilter"/>
                    <MenuItem Header="옛날 TV(CRT) 느낌" Tag="crt_royale" Click="OnFilter"/>
                </MenuItem>
                <MenuItem x:Name="FrameMenu" Header="프레임(_P)" ToolTip="화면을 그리는 초당 프레임 수와 수직 동기화를 설정합니다. 게임 진행 속도는 바뀌지 않습니다.">
                    <MenuItem Header="60 FPS (기본)" Tag="60" IsChecked="True" Click="OnFrameRate"/>
                    <MenuItem Header="120 FPS" Tag="120" Click="OnFrameRate"/>
                    <MenuItem Header="144 FPS" Tag="144" Click="OnFrameRate"/>
                    <MenuItem Header="240 FPS" Tag="240" Click="OnFrameRate"/>
                    <MenuItem Header="무제한" Tag="0" Click="OnFrameRate"/>
                    <Separator/>
                    <MenuItem x:Name="VSyncMenuItem" Header="수직 동기화(VSync)" IsCheckable="True" Click="OnToggleVSync"
                              ToolTip="모니터 주사율에 맞춰 그려 화면 찢어짐을 막습니다."/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="EspOverlayMenuItem" Header="ESP 오버레이(_E)" IsCheckable="True" Click="OnToggleEspOverlay"/>
                <MenuItem x:Name="TileInspectorMenuItem" Header="타일 인스펙터(_I)" IsCheckable="True" Click="OnToggleTileInspector"/>
                <Separator/>
                <MenuItem x:Name="InGameFontMenuItem" Header="인게임 글꼴 설정(_F)..." Click="OnInGameFontSettings"/>
            </MenuItem>
            <MenuItem x:Name="AudioMenu" Header="소리(_S)" IsEnabled="False">
                <MenuItem x:Name="VolumeMenu" Header="마스터 볼륨(_M)" ToolTip="게임 전체 소리 크기입니다. 게임에 소리 설정이 없어도 작동합니다.">
                    <MenuItem Header="음소거" Tag="0" Click="OnVolumeLevel"/>
                    <MenuItem Header="10%" Tag="10" Click="OnVolumeLevel"/>
                    <MenuItem Header="25%" Tag="25" Click="OnVolumeLevel"/>
                    <MenuItem Header="50%" Tag="50" Click="OnVolumeLevel"/>
                    <MenuItem Header="75%" Tag="75" Click="OnVolumeLevel"/>
                    <MenuItem Header="100% (기본)" Tag="100" IsChecked="True" Click="OnVolumeLevel"/>
                    <MenuItem Header="125%" Tag="125" Click="OnVolumeLevel"/>
                    <MenuItem Header="150%" Tag="150" Click="OnVolumeLevel"/>
                    <MenuItem Header="200%" Tag="200" Click="OnVolumeLevel"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="OutputDeviceMenu" Header="출력 장치(_D)"
                          ToolTip="게임 오디오를 출력할 장치를 선택합니다. '기본값'은 시스템 기본 장치를 따릅니다."
                          SubmenuOpened="OnOutputDeviceMenuOpened">
                    <MenuItem Header="기본값" Tag="" IsCheckable="True" IsChecked="True" Click="OnOutputDeviceClick"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="설정(_P)">
                <MenuItem Header="단축키 설정(_K)..." Click="OnHotkeySettings"/>
                <MenuItem x:Name="MenuBarMenuItem" Header="메뉴 숨기기(_H)" Click="OnMenuBarMenu" ToolTip="메뉴 줄을 숨깁니다. 같은 단축키를 다시 누르면 보입니다."/>
                <MenuItem Header="프로그램 폰트 변경(_F)..." Click="OnFontSettings"/>
                <MenuItem Header="RTP 폴더 지정(_R)..." Click="OnRtpFolders" ToolTip="RTP(기본 그림·소리 모음)가 있는 폴더를 직접 고릅니다. 비워 두면 자동으로 찾습니다."/>
                <MenuItem Header="메모 설정(_M)..." Click="OnMemoSettings" ToolTip="메모 기본 글꼴·크기·색, 글상자 글자 색, 노트 배경 색"/>
                <MenuItem x:Name="StreamerMenuItem" Header="스트리머 모드(_T)" IsCheckable="True" Click="OnToggleStreamer"
                          ToolTip="방송·화면 공유용: 노트 말고 도구와 단축키를 끄고, 메시지 바의 퀵 세이브/로드를 숨깁니다."/>
                <MenuItem x:Name="DiscordMenuItem" Header="디스코드에 플레이 중인 게임 표시(_D)" IsCheckable="True" Click="OnToggleDiscord"
                          ToolTip="디스코드 프로필에 'RocketRPG 하는 중'과 지금 플레이 중인 게임 제목, 플레이 시간을 보여 줍니다."/>
                <Separator/>
                <MenuItem Header="업데이트 확인(_U)" Click="OnCheckUpdate"/>
                <MenuItem Header="업데이트 받을 버전(_B)">
                    <MenuItem x:Name="UpdateStableItem" Header="정식 버전만(_S)" IsCheckable="True" Click="OnUpdateChannel" Tag="stable"
                              ToolTip="시험 중인 베타 버전은 받지 않습니다."/>
                    <MenuItem x:Name="UpdateBetaItem" Header="베타 버전도(_B)" IsCheckable="True" Click="OnUpdateChannel" Tag="beta"
                              ToolTip="새 기능을 먼저 써 보는 베타 버전도 받습니다. 아직 문제가 있을 수 있습니다."/>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="ToolMenu" Header="도구(_T)">
                <MenuItem x:Name="NotesMenuItem" Header="노트(_O)" IsCheckable="True" Click="OnToggleNotes" ToolTip="게임 중에는 게임 노트, 게임이 없으면 일반 메모"/>
                <MenuItem x:Name="ScreenshotOnlyMenuItem" Header="스크린샷 찍기(_P)" Click="OnScreenshotOnly" ToolTip="스크린샷 보관함에만 저장"/>
                <MenuItem x:Name="ScreenshotMenuItem" Header="스크린샷 찍어 노트에 넣기(_H)" Click="OnScreenshotToNote" ToolTip="보관함에 저장하고 노트에도 넣기"/>
                <MenuItem x:Name="GalleryMenuItem" Header="스크린샷 보관함(_G)..." Click="OnOpenGallery"/>
                <MenuItem x:Name="DialogueLogMenuItem" Header="대사 기록(_Y)..." Click="OnDialogueLogMenu" ToolTip="지나간 대사를 다시 보기 (멀티 참가자는 방장 게임의 대사)"/>
                <Separator/>
                <MenuItem x:Name="MapViewerMenuItem" Header="전체 맵 뷰어(_M)..." Click="OnMapViewer"/>
                <MenuItem x:Name="AssetViewerMenuItem" Header="에셋 보기(_E)..." Click="OnAssetViewer" ToolTip="게임의 그림·소리·글꼴 등을 내 PC에서만 둘러봅니다 (저장·내보내기 없음)"/>
                <MenuItem x:Name="DataInspectorMenuItem" Header="스위치/변수 관리자(_V)..." Click="OnDataInspector"/>
                <Separator/>
                <MenuItem x:Name="QuickSaveMenuItem" Header="퀵 세이브(_Q)" Click="OnQuickSaveMenu"/>
                <MenuItem x:Name="QuickLoadMenuItem" Header="퀵 로드(_L)" Click="OnQuickLoadMenu"/>
                <MenuItem x:Name="ForceSaveMenuItem" Header="세이브 화면 열기(_W)" Click="OnForceSaveMenu" ToolTip="세이브가 막힌 곳에서도 세이브 화면을 엽니다"/>
                <MenuItem x:Name="ForceLoadMenuItem" Header="로드 화면 열기(_O)" Click="OnForceLoadMenu"/>
                <Separator/>
                <MenuItem x:Name="NoclipMenuItem" Header="벽 통과 (노클립)(_N)" IsCheckable="True" Click="OnToggleNoclip"/>
                <MenuItem x:Name="PauseMenuItem" Header="일시 정지 / 재개(_Z)" Click="OnPauseMenu"/>
                <MenuItem x:Name="SpeedMenu" Header="배속 설정(_S)">
                    <MenuItem Header="0.5x" Tag="0.5" IsCheckable="True" Click="OnSpeedMenuClick"/>
                    <MenuItem Header="1.0x (기본)" Tag="1.0" IsCheckable="True" IsChecked="True" Click="OnSpeedMenuClick"/>
                    <MenuItem Header="2.0x" Tag="2.0" IsCheckable="True" Click="OnSpeedMenuClick"/>
                    <MenuItem Header="4.0x" Tag="4.0" IsCheckable="True" Click="OnSpeedMenuClick"/>
                    <MenuItem Header="8.0x" Tag="8.0" IsCheckable="True" Click="OnSpeedMenuClick"/>
                    <Separator/>
                    <MenuItem x:Name="SpeedUpMenuItem" Header="한 단계 빠르게(_U)" Tag="SpeedUp" Click="OnSpeedStepMenu"/>
                    <MenuItem x:Name="SpeedDownMenuItem" Header="한 단계 느리게(_D)" Tag="SpeedDown" Click="OnSpeedStepMenu"/>
                    <MenuItem x:Name="SpeedResetMenuItem" Header="원래 속도로(_R)" Tag="SpeedReset" Click="OnSpeedStepMenu"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="AutoMessageMenuItem" Header="메시지 자동 넘김(_A)" IsCheckable="True" Click="OnToggleAutoMessage"/>
                <MenuItem x:Name="AutoSpeedMenu" Header="자동 넘김 속도(_D)">
                    <MenuItem Header="0.5x (느리게)" Tag="0.5" Click="OnAutoSpeedMenu"/>
                    <MenuItem Header="1.0x (기본)" Tag="1.0" IsChecked="True" Click="OnAutoSpeedMenu"/>
                    <MenuItem Header="1.5x" Tag="1.5" Click="OnAutoSpeedMenu"/>
                    <MenuItem Header="2.0x" Tag="2.0" Click="OnAutoSpeedMenu"/>
                    <MenuItem Header="3.0x (빠르게)" Tag="3.0" Click="OnAutoSpeedMenu"/>
                </MenuItem>
                <MenuItem x:Name="SkipMessageMenuItem" Header="메시지 고속 스킵(_K)" IsCheckable="True" Click="OnToggleSkipMessage"/>
                <MenuItem x:Name="ShowMessageBarMenuItem" Header="메시지 제어 바 표시(_B)" IsCheckable="True" IsChecked="True" Click="OnToggleMessageBar"/>
                <Separator/>
                <MenuItem x:Name="ResetGameSettingsMenuItem" Header="게임 설정 리셋(_R)..." Click="OnResetGameSettings"
                          ToolTip="이 게임의 RocketRPG 설정(비율, 밝기, 필터, 볼륨, 글꼴, 프레임, 자동 넘김, HUD 위치)을 처음 상태로 되돌리고 게임을 다시 시작합니다."/>
            </MenuItem>
            <MenuItem x:Name="MultiMenu" Header="멀티(_U)">
                <MenuItem x:Name="MultiRoomHeader" Header="방" IsEnabled="False" Visibility="Collapsed"/>
                <MenuItem x:Name="MultiCodeItem" Header="방 코드 복사" Click="OnMultiCopyCode" Visibility="Collapsed"
                          ToolTip="방 코드를 알려 주면 목록에 없는 방(비공개 방)에도 들어올 수 있습니다."/>
                <MenuItem x:Name="MultiMembersMenu" Header="참가자" Visibility="Collapsed"/>
                <MenuItem x:Name="MultiChatItem" Header="채팅하기(_T)..." Click="OnMultiChatMenu" Visibility="Collapsed"
                          ToolTip="글은 이름 없이 게임 화면 위로 흘러갑니다. 누가 말했는지는 채팅 기록에서 볼 수 있습니다."/>
                <MenuItem x:Name="MultiChatLogItem" Header="채팅 기록(_H)..." Click="OnMultiChatLog" Visibility="Collapsed"/>
                <Separator x:Name="MultiRoomSeparator" Visibility="Collapsed"/>
                <MenuItem x:Name="MultiCreateItem" Header="방 생성하기(_C)..." Click="OnMultiCreate" ToolTip="방 이름과 비밀번호를 정해 방을 만듭니다. 내 게임 화면을 참가자가 함께 봅니다."/>
                <MenuItem x:Name="MultiJoinItem" Header="방 입장하기(_J)..." Click="OnMultiJoin" ToolTip="열린 방 목록에서 고르거나 방 코드로 들어갑니다."/>
                <MenuItem x:Name="MultiSettingsMenu" Header="방 설정(_S)">
                    <MenuItem Header="이름 설정하기(_N)..." Click="OnMultiRename"/>
                    <MenuItem x:Name="MultiHidePingsItem" Header="방에 오는 핑 안 보기(_P)" IsCheckable="True" Click="OnMultiHidePings"/>
                    <MenuItem x:Name="MultiHideChatItem" Header="방에 오는 채팅 안 보기(_T)" IsCheckable="True" Click="OnMultiHideChat"/>
                    <MenuItem x:Name="MultiControlItem" Header="조종 권한 켜기(_K)" IsCheckable="True" Click="OnMultiControl" Visibility="Collapsed"
                              ToolTip="다른 참가자도 키보드로 게임을 조작할 수 있습니다. (방장 전용)"/>
                    <MenuItem x:Name="MultiNotesEditItem" Header="참가자도 노트 고치기(_E)" IsCheckable="True" IsChecked="True" Click="OnMultiNotesEditable" Visibility="Collapsed"
                              ToolTip="끄면 참가자는 방장의 게임 노트를 보기만 합니다. 페이지 관리는 항상 방장만 합니다."/>
                    <MenuItem x:Name="MultiQualityMenu" Header="방송 화질(_Q)" Visibility="Collapsed"
                              ToolTip="참가자에게 보내는 화면의 선명함과 부드러움. 높을수록 방장 인터넷 업로드를 더 씁니다.">
                        <MenuItem x:Name="MultiQualityLow" Header="낮음 (540p)" IsCheckable="True" Tag="low" Click="OnMultiQuality"/>
                        <MenuItem x:Name="MultiQualityNormal" Header="보통 (720p)" IsCheckable="True" Tag="normal" Click="OnMultiQuality"/>
                        <MenuItem x:Name="MultiQualityHigh" Header="높음 (1080p)" IsCheckable="True" Tag="high" Click="OnMultiQuality"/>
                        <Separator/>
                        <MenuItem x:Name="MultiFps30" Header="초당 30프레임" IsCheckable="True" Tag="30" Click="OnMultiFps"/>
                        <MenuItem x:Name="MultiFps60" Header="초당 60프레임" IsCheckable="True" Tag="60" Click="OnMultiFps"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem x:Name="MultiLeaveItem" Header="방 나가기(_L)" Click="OnMultiLeave" Visibility="Collapsed"/>
                <MenuItem x:Name="MultiDissolveItem" Header="방 해체하기(_D)" Click="OnMultiDissolve" Visibility="Collapsed"/>
            </MenuItem>
            <MenuItem Header="정보(_A)">
                <MenuItem Header="사용법(_U)..." Click="OnTutorial" ToolTip="처음 쓰는 사람을 위한 그림 사용법"/>
                <MenuItem Header="RocketRPG 정보 / 라이선스(_A)..." Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- 알림 막대: 게임에 필요한데 빠진 것(RTP, 글꼴)을 쉬운 말로 알려 줍니다 (GameIssueAdvisor) -->
        <Border x:Name="IssueBar" DockPanel.Dock="Top" Background="#FFFFF4CE" BorderBrush="#FFE0C060" BorderThickness="0,0,0,1"
                Padding="10,5" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="IssueCloseButton" DockPanel.Dock="Right" Content="닫기" Padding="8,1" Margin="6,0,0,0" Click="OnIssueClose"/>
                <Button x:Name="IssueDismissButton" DockPanel.Dock="Right" Content="이 게임에서 다시 보지 않기" Padding="8,1" Margin="6,0,0,0" Click="OnIssueDismiss"/>
                <Button x:Name="IssueActionButton" DockPanel.Dock="Right" Padding="8,1" Margin="6,0,0,0" Click="OnIssueAction"/>
                <TextBlock x:Name="IssueText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FF3A3000"/>
            </DockPanel>
        </Border>
        <!-- 게임 화면. 노트(Ctrl+N)는 창 오른쪽 바깥에 붙는 NotesDockWindow 또는 따로 띄운 NotesWindow에 있습니다. -->
        <Grid x:Name="MainArea">
        <Grid x:Name="RenderScreen" Grid.Column="0" Background="Black" SizeChanged="RenderScreen_SizeChanged"
              Focusable="True" ClipToBounds="True"
              KeyboardNavigation.DirectionalNavigation="None"
              KeyboardNavigation.TabNavigation="None"
              MouseMove="OnGameMouseMove"
              PreviewMouseDown="OnGameMouseDown" PreviewMouseUp="OnGameMouseUp">
            <ContentControl x:Name="NativeScreenHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>
            <wv2:WebView2 x:Name="WebScreen" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>
            <!-- 멀티 참가자: 방장 화면 자리 (영상이 오기 전 안내) -->
            <Border x:Name="MultiWaitPanel" Background="Black" Visibility="Collapsed">
                <TextBlock x:Name="MultiWaitText" Foreground="#FFCFCFCF" FontSize="16" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
            </Border>
            <!-- ESP / HUD / 메시지 바 / 토스트는 OverlayWindow(투명 계층 창)에 있습니다 (네이티브 창 위에 표시하기 위함) -->
        </Grid>
            <views:NotesPanel x:Name="NotesHost" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
