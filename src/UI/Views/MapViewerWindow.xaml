<Window x:Class="RocketRPG.Views.MapViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="전체 맵 뷰어 &amp; 워프 (Map Viewer)" Height="680" Width="1000"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI, 맑은 고딕" FontSize="12"
        Background="#FFF0F0F0">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="400"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 맵 목록 탐색기 -->
        <GroupBox Grid.Column="0" Header="맵 목록" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 검색창 -->
                <TextBox x:Name="SearchMapBox" Grid.Row="0" Margin="0,0,0,6" Padding="4,3"
                         ToolTip="맵 ID 또는 맵 이름을 검색하세요." TextChanged="SearchMapBox_TextChanged"/>

                <!-- 맵 리스트 -->
                <ListBox x:Name="MapListBox" Grid.Row="1" SelectionChanged="MapListBox_SelectionChanged"
                         BorderThickness="1" BorderBrush="#FFCCCCCC">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentPlayerMap}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Background" Value="#22007ACC"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,1">
                                <TextBlock Text="{Binding DisplayHeader}" FontWeight="SemiBold"
                                           Foreground="#FF0066CC" DockPanel.Dock="Left"/>
                                <TextBlock Text=" [현재 위치]" FontWeight="Bold" Foreground="#FFFF3300"
                                           Visibility="{Binding IsCurrentPlayerMap, Converter={StaticResource BoolToVisConverter}}"
                                           DockPanel.Dock="Right"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- 우측: 맵 렌더링 뷰어 및 워프 컨트롤 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 상단 맵 정보 바 -->
            <Border Grid.Row="0" Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1"
                    Padding="10,6" Margin="0,0,0,8" CornerRadius="4">
                <DockPanel>
                    <TextBlock x:Name="MapHeaderInfo" Text="맵을 선택해 주세요." FontWeight="Bold"
                               FontSize="13" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <TextBlock x:Name="TxtZoom" Text="배율: 100%" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="80"/>
                        <Button Content="−" Width="26" Height="22" Margin="0,0,2,0" Click="BtnZoomOut_Click" ToolTip="축소 (마우스 휠 아래)"/>
                        <Button Content="+" Width="26" Height="22" Margin="0,0,6,0" Click="BtnZoomIn_Click" ToolTip="확대 (마우스 휠 위)"/>
                        <Button Content="맞춤" Width="44" Height="22" Margin="0,0,2,0" Click="BtnZoomFit_Click" ToolTip="맵 전체가 보이게"/>
                        <Button Content="100%" Width="44" Height="22" Click="BtnZoomReset_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 맵 캔버스 영역 (스크롤 지원) -->
            <Grid Grid.Row="1">
            <Border Background="#FF1E1E1E" BorderBrush="#FFA0A0A0" BorderThickness="1">
                <!-- 휠: 마우스 위치 기준 확대/축소, 오른쪽 버튼 끌기: 이동, 왼쪽 클릭: 타일 정보, 더블 클릭: 워프 -->
                <ScrollViewer x:Name="MapScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel"
                              PreviewMouseRightButtonDown="MapScrollViewer_PreviewMouseRightButtonDown"
                              PreviewMouseMove="MapScrollViewer_PreviewMouseMove"
                              PreviewMouseRightButtonUp="MapScrollViewer_PreviewMouseRightButtonUp">
                    <Grid x:Name="MapRenderContainer" HorizontalAlignment="Left" VerticalAlignment="Top"
                          Background="Transparent"
                          MouseMove="MapRenderContainer_MouseMove"
                          MouseLeftButtonDown="MapRenderContainer_MouseLeftButtonDown">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>
                        <Image x:Name="MapTileImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Canvas x:Name="MapOverlayCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/>
                    </Grid>
                </ScrollViewer>
            </Border>
            <!-- 맵을 그리는 동안 -->
            <Border x:Name="MapLoading" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,8" Background="#E6F0F0F0"
                    BorderBrush="#FF808080" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="맵을 불러오는 중..." Foreground="#FF1E1E1E"/>
            </Border>
            </Grid>

            <!-- 하단: 선택한 타일 정보(이벤트, 장소 이동 목적지) + 워프 -->
            <GroupBox Grid.Row="2" Header="선택한 타일" Margin="0,8,0,0" Padding="8,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtTileInfo" Grid.Row="0" TextWrapping="Wrap" Foreground="#FF333333"
                               Text="맵의 타일을 클릭하면 정보가 나옵니다. 휠: 확대/축소 · 오른쪽 버튼 끌기: 이동 · 더블 클릭: 워프"/>
                    <!-- 장소 이동 이벤트의 목적지 (클릭하면 그 맵을 열거나 바로 워프) -->
                    <WrapPanel x:Name="TransferPanel" Grid.Row="1" Margin="0,4,0,0"/>
                    <DockPanel Grid.Row="2" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtWarpX" Width="55" Padding="4,2" Margin="0,0,10,0"/>
                            <TextBlock Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtWarpY" Width="55" Padding="4,2" Margin="0,0,12,0"/>
                            <Button x:Name="BtnWarp" Content="이 맵/좌표로 워프" FontWeight="SemiBold"
                                    Width="140" Height="26" Click="BtnWarp_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <TextBlock x:Name="TxtHoverStatus" Text="좌표: (-, -)" VerticalAlignment="Center"
                                       Foreground="#FF666666" Margin="0,0,12,0"/>
                            <Button x:Name="BtnClose" Content="닫기(_C)" Width="70" Height="26" IsCancel="True" Click="BtnClose_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
