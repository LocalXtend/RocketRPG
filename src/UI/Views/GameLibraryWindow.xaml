<Window x:Class="RocketRPG.Views.GameLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="쯔꾸르 모음 (가상 탐색기)" Height="580" Width="820"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI, 맑은 고딕" FontSize="12"
        Background="#FFD4D0C8">
    <Window.Resources>
        <!-- Windows 98 클래식 툴바 버튼 스타일 -->
        <Style x:Key="Win98ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFD4D0C8"/>
            <Setter Property="BorderBrush" Value="#FFA0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="1,0,3,0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 큰 아이콘 / 클래식 바탕화면 보기 템플릿 (폴더 및 게임 공용) -->
        <DataTemplate x:Key="IconViewTemplate">
            <Border Padding="6,6" Margin="4" Width="100" Height="90" Background="Transparent" SnapsToDevicePixels="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Image Source="{Binding Icon}" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,4"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="38"
                               Foreground="#FF000000" TextTrimming="CharacterEllipsis" FontSize="11"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 자세히 보기 템플릿 -->
        <DataTemplate x:Key="ListViewTemplate">
            <Border Padding="4,2" Margin="1" Background="Transparent" SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#FF000000" TextTrimming="CharacterEllipsis" Width="280"/>
                    <TextBlock Text="{Binding Description}" VerticalAlignment="Center" Foreground="#FF555555" Width="200" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="IconWrapPanel">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ListStackPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Windows 98 클래식 상단 툴바 -->
        <Border Grid.Row="0" Background="#FFD4D0C8" BorderBrush="#FF808080" BorderThickness="1,1,1,0" Padding="4,4,4,2">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- 상위/뒤로가기 버튼 -->
                    <Button x:Name="BtnBack" Style="{StaticResource Win98ToolButtonStyle}" MinWidth="75" Click="BtnBack_Click" ToolTip="상위 폴더 목록으로 이동">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="ImgBack" Width="16" Height="16" Margin="0,0,4,0"/>
                            <AccessText Text="위로(_U)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Margin="3,2,6,2" Background="#FF808080"/>

                    <Button x:Name="BtnAddFolder" Content="폴더 추가(_A)..." Style="{StaticResource Win98ToolButtonStyle}" Width="95" Click="BtnAddFolder_Click"/>
                    <Button x:Name="BtnRemoveFolder" Content="폴더 삭제(_D)" Style="{StaticResource Win98ToolButtonStyle}" Width="85" Click="BtnRemoveFolder_Click"/>
                    <Button x:Name="BtnRefresh" Content="새로고침(_R)" Style="{StaticResource Win98ToolButtonStyle}" Width="80" Click="BtnRefresh_Click"/>

                    <Separator Width="1" Margin="3,2,6,2" Background="#FF808080"/>

                    <Button x:Name="BtnViewIcons" Content="아이콘 보기" Style="{StaticResource Win98ToolButtonStyle}" Width="80" Click="BtnViewIcons_Click"/>
                    <Button x:Name="BtnViewList" Content="간단히 보기" Style="{StaticResource Win98ToolButtonStyle}" Width="80" Click="BtnViewList_Click"/>
                </StackPanel>

                <!-- 선택 게임 실행 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnLaunchSelected" Content="선택 실행(_L)" FontWeight="Bold" Style="{StaticResource Win98ToolButtonStyle}" Width="90" Click="BtnLaunchSelected_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Windows 98 클래식 주소 표시줄 -->
        <Border Grid.Row="1" Background="#FFD4D0C8" BorderBrush="#FF808080" BorderThickness="1,0,1,1" Padding="4,2,4,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="주소(D):" VerticalAlignment="Center" Margin="2,0,6,0" Foreground="#FF000000"/>
                <Border Grid.Column="1" Background="White" BorderBrush="#FF808080" BorderThickness="1">
                    <TextBox x:Name="AddressBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="4,1"
                             IsReadOnly="True" Text="컴퓨터"/>
                </Border>

                <!-- 검색창 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock Text="검색:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="SearchBox" Width="140" Height="22" VerticalContentAlignment="Center" Padding="3,1"
                             TextChanged="SearchBox_TextChanged"/>
                    <Button x:Name="BtnClearSearch" Content="초기화" Style="{StaticResource Win98ToolButtonStyle}" Height="22" Padding="4,0" Margin="3,0,0,0" Click="BtnClearSearch_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. 가상 탐색기 뷰 (Windows 98 3D 음각 테두리) -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FF808080" BorderThickness="2" Margin="0,4,0,4">
            <ListView x:Name="ExplorerListView" BorderThickness="0" Background="White"
                      MouseDoubleClick="ExplorerListView_MouseDoubleClick"
                      KeyDown="ExplorerListView_KeyDown"
                      SelectionChanged="ExplorerListView_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- 4. Windows 98 상태 표시줄 -->
        <Border Grid.Row="3" Background="#FFD4D0C8" BorderBrush="#FF808080" BorderThickness="1" Padding="6,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="준비 완료" Foreground="#FF000000" VerticalAlignment="Center"/>
                <!-- 폴더를 훑는 동안 -->
                <ProgressBar x:Name="ScanProgress" Grid.Column="1" Width="120" Height="12" Margin="0,0,10,0" IsIndeterminate="True"
                             Visibility="Collapsed" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" Grid.Column="2" Text="0개 개체" Foreground="#FF000000" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
