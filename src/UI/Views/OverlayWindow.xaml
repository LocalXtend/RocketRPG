<Window x:Class="RocketRPG.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RocketRPG.Views"
        Title="RocketRPG Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!--
        게임 화면(RenderScreen) 위에 정확히 겹쳐지는 투명 오버레이 창.
        네이티브 모드에서 게임 창(HWND)이 WPF 위에 그려지는 에어스페이스 문제를 피하기 위해
        모든 HUD 요소를 별도 계층 창에 둡니다. 완전 투명 픽셀은 클릭이 아래 게임으로 통과합니다.
    -->
    <Grid x:Name="Root" ClipToBounds="True">
        <views:EspLayer x:Name="EspCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- 상단 좌측 HUD 핀 고정 변수 오버레이 (최대 10개). 토스트와 같은 흰 바탕 스타일 -->
        <Border x:Name="PinnedVarsOverlay" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="12,12,0,0" Padding="10,6" Background="#F2FFFFFF" BorderBrush="#FF707070"
                BorderThickness="1" CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
            </Border.Effect>
            <StackPanel x:Name="PinnedVarsStack"/>
        </Border>

        <!-- 하단 Ren'Py 퀵 메뉴: 대화창이 표시될 때만 나타남. 게임 화면 아래 비워 둔 30px 자리(MainWindow.MessageBarHeight)에 놓입니다 -->
        <views:RenpyMessageBar x:Name="RenpyMsgBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="30"
                               Visibility="Collapsed"/>

        <!-- 토스트 메시지 컨테이너 -->
        <StackPanel x:Name="ToastStack" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,40" IsHitTestVisible="False"/>

        <Border x:Name="TileInspectorHud" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Padding="10,5"
                Background="#F2FFFFFF" BorderBrush="#FF707070" BorderThickness="1" CornerRadius="2"
                Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
            </Border.Effect>
            <TextBlock x:Name="TileInspectorText" Foreground="#FF1E1E1E" FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <!-- 게임 불러오는 중: 게임 창(에어스페이스) 위에도 보이도록 이 오버레이 창에 둡니다 -->
        <Grid x:Name="GameLoadingOverlay" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Background="#99000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFF0F0F0" BorderBrush="#FF808080" BorderThickness="1"
                    CornerRadius="6" Padding="36,26" MinWidth="260" SnapsToDevicePixels="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 원모양으로 돌아가는 원들(실제로는 색만 바꾼거지만 사람 눈에는 그렇게 보이기에) -->
                    <Canvas x:Name="SpinnerCanvas" Width="64" Height="64" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingGameTitle" Text="게임 제목" FontSize="14" FontWeight="Bold"
                               Foreground="#FF1E1E1E" TextAlignment="Center" Margin="0,16,0,4"
                               MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="LoadingStatusSub" Text="게임을 시작하는 중..." FontSize="11"
                               Foreground="#FF666666" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
