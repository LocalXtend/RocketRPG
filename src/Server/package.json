{
  "name": "rocketrpg-multi",
  "private": true,
  "version": "1.0.0",
  "description": "RocketRPG multiplayer server (room list, room relay, WebRTC signaling) on Cloudflare Workers + Durable Objects",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.142.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  }
}
